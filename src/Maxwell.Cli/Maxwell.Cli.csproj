<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Maxwell.Cli</RootNamespace>
    <AssemblyName>maxwell-cli</AssemblyName>

    <!-- Lets "dotnet pack" / "dotnet tool install -g" publish this as the
         `maxwell-cli` command usable from any directory, per the spec. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>maxwell-cli</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maxwell.Agents\Maxwell.Agents.csproj" />
  </ItemGroup>

</Project>
