<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Maxwell.Agents</RootNamespace>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Skills that ship with Maxwell; BuiltInSkillSeeder copies them into ~/.maxwell/skills on first run.
         LogicalName keeps the folder layout in the resource name (otherwise MSBuild mangles it). -->
    <EmbeddedResource Include="BuiltInSkills\**\*.*" LogicalName="BuiltInSkills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal types (e.g. the Porter stemmer). -->
    <InternalsVisibleTo Include="Maxwell.Agents.Tests" />
  </ItemGroup> 

  <ItemGroup>
    <!-- Core Microsoft Agent Framework -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.27.0" />

    <!-- Provider wrapper. We use the OpenAI-flavoured toolkit package because
         llama.cpp's server exposes an OpenAI-compatible /v1 endpoint, so it can be
         targeted by pointing OpenAIConnection.Endpoint at the local llama.cpp server. -->
    <PackageReference Include="AgentFrameworkToolkit.OpenAI" Version="1.27.0" />

    <!-- Optional: turns the on-disk skills/{Agent}/ folders into agent tools + extra
         instructions. If this package (or its expected shape) is unavailable in your
         feed, remove this reference and the code in SkillLoader.cs - skills are an
         additive, best-effort feature and are not required for the CLI to work. -->
    <PackageReference Include="AgentSkillsDotNet" Version="*" />
  </ItemGroup>

</Project>
